{
  "name": "locked-mp4-player",
  "version": "1.0.0",
  "description": "A strict .mp4 player that blocks all controls except 5-second rewind and closes after playback.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.lockedmp4player",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "electron": "^37.2.3"
  },
  "devDependencies": {
    "electron-builder": "^25.6.0"
  },
  "author": "Your Name",
  "license": "MIT"
}